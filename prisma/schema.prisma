// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


model User {
  user_id       String  @id @default(uuid()) @db.VarChar(100)
  name          String? @db.VarChar(100)
  email         String  @unique @db.VarChar(100)
  password      String  @db.VarChar(100)
  phone_number  String  @unique @db.VarChar(100)
  address       String? @db.VarChar(100)
  role          String  @default("user")
  profile_picture String? @db.Text  

  products        Product[]  @relation("UserProducts")
  banners         Banner[]   @relation("UserBanners")

  @@map("users")
}

model Category {
  category_id String   @id @default(uuid()) @db.VarChar(100)
  name        String   @unique @db.VarChar(100)
  image_url      String?  @db.Text
  description String?  @db.Text

  products    Product[]

  @@map("categories")
}

model Product {
  product_id     String   @id @default(uuid()) @db.VarChar(100)
  name           String   @db.VarChar(100)
  description    String?  @db.Text
  price          Int
  stock          Int
  image_url      String?  @db.Text
  category_id    String
  created_by_id  String

  category       Category @relation(fields: [category_id], references: [category_id])
  created_by     User     @relation("UserProducts", fields: [created_by_id], references: [user_id])

  @@map("products")
}

model Banner {
  banner_id   String  @id @default(uuid()) @db.VarChar(100)
  title       String  @db.VarChar(100)
  image_url   String  @db.Text
  created_by  String

  user        User    @relation("UserBanners", fields: [created_by], references: [user_id])

  @@map("banners")
}


